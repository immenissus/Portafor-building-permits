{
  "$schema": "https://opencode.ai/config.json",

  // Project instructions are loaded automatically from AGENTS.md at the repo root.
  "instructions": ["AGENTS.md"],

  // Project-local skills live in .opencode/skills/<name>/SKILL.md
  "skills": {
    "paths": [".opencode/skills"]
  },

  // LSP servers: built-ins (TypeScript/TSX via typescript-language-server, etc.)
  // are enabled by default; this makes that explicit.
  "lsp": true,

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  // MCP servers. Local (npx/docker) servers can be slow on first cold start, so
  // the default per-server and global MCP request timeouts are raised well above
  // the 5s default. Secrets are never stored here — only {env:VAR} references.
  "mcp": {
    // GitHub — PRs, issues, releases. Official server run locally via Docker.
    // No PAT needed: the official image ships GitHub's own OAuth app and does a
    // browser-based login on first use (token kept in memory only). Requires
    // Docker Desktop to be running; the container publishes the OAuth callback
    // on 127.0.0.1:8085.
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-p",
        "127.0.0.1:8085:8085",
        "-e",
        "GITHUB_OAUTH_CALLBACK_PORT",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_OAUTH_CALLBACK_PORT": "8085"
      },
      "enabled": true,
      "timeout": 120000
    },
    // Context7 — up-to-date docs for the libraries in this repo (Next 16, React 19,
    // Drizzle, Clerk, Stripe, Mapbox GL, PostGIS).
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "timeout": 120000
    },
    // Playwright — browser automation / UI testing for the Next.js app.
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "timeout": 120000
    },
    // Supabase — OFFICIAL server, run locally via npx. Scoped to the project in
    // SUPABASE_PROJECT_REF and authenticated with a personal access token
    // (SUPABASE_ACCESS_TOKEN); both are read from the environment so no secrets
    // live in this file. Token: Supabase Dashboard → Account → Access Tokens.
    // Project ref: Dashboard → Project Settings → General.
    "supabase": {
      "type": "local",
      "command": ["npx", "-y", "@supabase/mcp-server-supabase@latest"],
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}",
        "SUPABASE_PROJECT_REF": "{env:SUPABASE_PROJECT_REF}"
      },
      "enabled": true,
      "timeout": 120000
    },
    // Sentry — OFFICIAL server. OAuth device flow on first use (browser login,
    // token cached by the client). Scoped to whatever orgs your Sentry account
    // can access; the app's Sentry project is configured via SENTRY_ORG /
    // SENTRY_PROJECT for the SDK, not the MCP.
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true,
      "timeout": 120000
    },
    // Postgres — read-only schema/sample inspection is enabled by default.
    // WARNING: this grants live SQL access to your database via DATABASE_URL.
    // To use it, set type/command and enabled: true, e.g.:
    //   "postgres": {
    //     "type": "local",
    //     "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "{env:DATABASE_URL}"],
    //     "enabled": true
    //   }
    "postgres": {
      "enabled": false
    }
  },

  "experimental": {
    "mcp_timeout": 120000
  }
}
