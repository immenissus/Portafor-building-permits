build/
dist/

# Local env files (highly critical, do not commit)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & editor caches
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript build artifacts
*.tsbuildinfo

# Agent/assistant working files
.mimocode/

# Python (dev scripts, optional backend)
__pycache__/
*.pyc
.venv/

# Operating System files
.DS_Store
Thumbs.db

# Sentry Config File
.env.sentry-build-plugin

# Benchmark generated output (runs + aggregate artifacts)
bench/runs/
bench/aggregate/
